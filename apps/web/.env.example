# Python API origin (server-side only; the browser never calls it directly)
API_URL=http://localhost:8000

# Shared secret for the web -> api hop (must match the api's INTERNAL_API_KEY)
INTERNAL_API_KEY=change-me

# Admin password (gates /admin; must match the api's ADMIN_PASSWORD)
ADMIN_PASSWORD=change-me

# Vercel Blob token for minting admin client-upload tokens
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
