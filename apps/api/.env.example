# Local dev database (docker-compose.yml in this directory)
DATABASE_URL=postgresql://citebear:citebear@localhost:5432/citebear

# OpenAI-compatible model gateway (Vercel AI Gateway by default;
# OpenRouter or self-hosted LiteLLM are a two-env-var swap)
GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
GATEWAY_API_KEY=your-gateway-key

# Shared secret for the web -> api hop
INTERNAL_API_KEY=change-me

# Models (provider/model strings resolved by the gateway)
CHAT_MODEL=anthropic/claude-haiku-4-5
EMBEDDING_MODEL=openai/text-embedding-3-small
